rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny catch-all safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Common Security Helper Functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidTask(data) {
      return data.userId is string &&
        data.userId == request.auth.uid &&
        data.taskName is string &&
        data.taskName.size() >= 1 &&
        data.taskName.size() <= 200 &&
        data.description is string &&
        data.description.size() <= 2000 &&
        data.deadline is string &&
        data.deadline.size() <= 100 &&
        (data.status == 'Pending' || data.status == 'Completed' || 
         data.status == 'TODO' || data.status == 'IN_PROGRESS' || data.status == 'DONE') &&
        data.createdAt is string &&
        data.createdAt.size() <= 50 &&
        data.updatedAt is string &&
        data.updatedAt.size() <= 50;
    }

    function isValidUserProfile(data) {
      return data.id is string &&
        data.id == request.auth.uid &&
        data.name is string &&
        data.name.size() <= 100 &&
        data.email is string &&
        data.email.size() <= 150;
    }

    // Tasks Collection Rules
    match /tasks/{taskId} {
      allow get: if isSignedIn() && existing().userId == request.auth.uid;
      allow list: if isSignedIn();
      allow create: if isSignedIn() &&
        isValidId(taskId) &&
        isValidTask(incoming()) &&
        incoming().userId == request.auth.uid;
      allow update: if isSignedIn() &&
        isValidId(taskId) &&
        isValidTask(incoming()) &&
        existing().userId == request.auth.uid &&
        incoming().userId == existing().userId &&
        incoming().createdAt == existing().createdAt;
      allow delete: if isSignedIn() &&
        isValidId(taskId) &&
        existing().userId == request.auth.uid;
    }

    // Users Collection Rules
    match /users/{userId} {
      allow get: if isSignedIn() && userId == request.auth.uid;
      allow create, update: if isSignedIn() &&
        userId == request.auth.uid &&
        isValidId(userId) &&
        isValidUserProfile(incoming());
      allow delete: if false;
    }
  }
}
